{
  "name": "dsh-relaydeck",
  "version": "0.1.0",
  "description": "RelayDeck — a DSH-native content relay workbench. Flows (source → filters → actions) that collect, transform and move content across platforms; runs are traced and replayable. Self-contained: ships its own Node backend, no external runtime.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "server",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts",
    "test",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "icon": "icon.svg",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "pack": "node scripts/dev-pack.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "relaydeck",
    "content",
    "flow",
    "automation"
  ]
}
