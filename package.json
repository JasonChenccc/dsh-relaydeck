{
  "name": "creatorhub-dsh",
  "version": "0.1.0",
  "description": "CreatorHub (local 抖音/小红书/快手/视频号/TikTok content workbench) bridge for DeepSeek Harness: managed backend lifecycle, read-only API tools, approval-gated write tools and a desktop sidebar panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "test"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "creatorhub",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "icon": "icon.svg"
}
