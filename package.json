{
  "name": "creatorhub-dsh",
  "version": "0.1.0",
  "description": "CreatorHub local content-workbench bridge for DeepSeek Harness (Phase 1 skeleton: creatorhub_ping stub, no network, no process spawn)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "test",
    "client.js"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "creatorhub",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
